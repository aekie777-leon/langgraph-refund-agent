# OpenAI or an OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=
# Leave empty when using the official OpenAI API.
OPENAI_BASE_URL=

# Required by the standalone LangGraph Agent Server.
LANGSMITH_API_KEY=

# PostgreSQL for local Python execution. Docker Compose overrides POSTGRES_URI
# so the API container connects to the "postgres" service automatically.
POSTGRES_URI=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=refund_agent

# Optional: dedicated database used only by PostgreSQL integration tests.
# Never point this at a production database.
CASE_TEST_POSTGRES_URI=

# Text shown when a refund requires human review.
CUSTOMER_SERVICE_CONTACT=your customer service team

# Demo identities used by the local authentication provider. This is a JSON
# object mapping bearer tokens to {"user_id", "tenant_id", "role"}. Permissions
# are derived from the role by the backend; tokens are demo-only and must never
# be real credentials. Leave empty to disable demo authentication (every request
# is then rejected with 401).
# Example (customer-a owns ORD-10001..ORD-10011, customer-b owns ORD-20001,
# customer-c owns ORD-30001 in the other tenant):
# DEMO_IDENTITY_TOKENS={"demo-customer-token":{"user_id":"customer-a","tenant_id":"tenant-demo","role":"customer"},"demo-b-token":{"user_id":"customer-b","tenant_id":"tenant-demo","role":"customer"},"demo-c-token":{"user_id":"customer-c","tenant_id":"tenant-other","role":"customer"},"demo-agent-token":{"user_id":"agent-7","tenant_id":"tenant-demo","role":"support_agent"},"demo-supervisor-token":{"user_id":"sup-1","tenant_id":"tenant-demo","role":"supervisor"}}
DEMO_IDENTITY_TOKENS=
