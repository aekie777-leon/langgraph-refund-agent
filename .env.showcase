# Public, synthetic values for the local-only portfolio showcase.
# Nothing in this file is a production credential.
APP_ENV_FILE=.env.showcase
COMPOSE_PROJECT_NAME=refund-agent-showcase
APP_ENV=development
SHOWCASE_MODE=true
IDENTITY_PROVIDER=demo
IDENTITY_DIRECTORY=none
DEMO_IDENTITY_TOKENS={"showcase-customer-a":{"user_id":"customer-a","tenant_id":"tenant-demo","role":"customer"},"showcase-customer-b":{"user_id":"customer-b","tenant_id":"tenant-demo","role":"customer"},"showcase-agent":{"user_id":"agent-7","tenant_id":"tenant-demo","role":"support_agent"},"showcase-supervisor":{"user_id":"sup-1","tenant_id":"tenant-demo","role":"supervisor"}}

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Compose's production base file requires this variable during interpolation.
# The showcase API override removes it from the container environment.
LANGSMITH_API_KEY=showcase-compose-interpolation-only
LANGCHAIN_TRACING_V2=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=showcase-postgres-only
POSTGRES_DB=refund_agent

CUSTOMER_SERVICE_CONTACT=the local showcase support team
PROVIDER_ALLOW_INSECURE_HTTP=true
PROVIDER_CONNECTIONS_JSON=[{"connection_id":"provider-demo","tenant_id":"tenant-demo","capability":"order_operation","base_url":"http://provider-simulator:8090","endpoint":"/v1/commands","authentication":{"scheme":"none"},"timeout":{"connect_seconds":5,"read_seconds":10,"write_seconds":10},"max_concurrency":4,"requests_per_second":10}]
PROVIDER_WEBHOOK_CONNECTIONS_JSON=[{"connection_id":"provider-demo","tenant_id":"tenant-demo","signing_secret":"synthetic-showcase-webhook-secret","validity_window_seconds":300}]
SHOWCASE_PROVIDER_CALLBACK_URL=http://langgraph-api:8000/webhooks/providers/provider-demo
SHOWCASE_PROVIDER_WEBHOOK_SECRET=synthetic-showcase-webhook-secret
OUTBOX_WORKER_ID=showcase-outbox
INBOX_WORKER_ID=showcase-inbox
